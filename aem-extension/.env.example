# Copy this file to .env and fill in values for the App Builder project and
# AEM/Firefly environment you are deploying to. Never commit .env.

# Set by `aio app use` / `aio login` for the target App Builder workspace.
AIO_RUNTIME_NAMESPACE=
AIO_RUNTIME_AUTH=

# Firefly Services / InDesign API OAuth Server-to-Server credential.
FFS_CLIENT_ID=
FFS_CLIENT_SECRET=
FFS_ORG_ID=
FFS_SCOPES=openid,AdobeID,firefly_api,ff_apis,indesign_services
IMS_ENDPOINT=https://ims-na1.adobelogin.com/ims/token/v3
INDESIGN_EXECUTE_URL=

# AEM as a Cloud Service author environment for this workspace.
# Required for deployment and local testing. Set the author URL for this AEM env.
AEM_AUTHOR_URL=
# Prefer the durable Service Credential. Use AEM_DEV_TOKEN only for local tests.
AEM_SC_JSON=
AEM_DEV_TOKEN=
# Optional shared font folder; per-job <folder>/fonts is also supported.
AEM_FONTS_PATH=/content/dam/fonts
