# Copy this file to .env and fill in values for the App Builder project and
# AEM/Firefly environment you are deploying to. Never commit .env.

# Set by `aio app use` / `aio login` for the target App Builder workspace.
AIO_RUNTIME_NAMESPACE=
AIO_RUNTIME_AUTH=

# Firefly Services / InDesign API OAuth Server-to-Server credential.
FFS_CLIENT_ID=
FFS_CLIENT_SECRET=
FFS_ORG_ID=
FFS_SCOPES=openid,AdobeID,firefly_api,ff_apis,indesign_services
IMS_ENDPOINT=https://ims-na1.adobelogin.com/ims/token/v3
INDESIGN_EXECUTE_URL=

# AEM as a Cloud Service author environment for this workspace.
# Required for deployment and local testing. Set the author URL for this AEM env.
AEM_AUTHOR_URL=
# Prefer the durable Service Credential. Use AEM_DEV_TOKEN only for local tests.
AEM_SC_JSON=
AEM_DEV_TOKEN=
# Optional shared font folder; per-job <folder>/fonts is also supported.
AEM_FONTS_PATH=/content/dam/fonts
# Assets View URL slug ("@org" in experience.adobe.com/#/@org/assets/...) for the output-folder link; omit for no link
ASSETS_VIEW_TENANT=@yourorg
# PSD templates: aspect of the photo frame in the matching InDesign template (width/height). Wide frames crop the
# right side so the left of the photo stays prominent. Default 2.4709 (1700/688); 0 = cover only the visible area.
PSD_HERO_FRAME_ASPECT=2.4709

# HTML5 banners (Document Authoring pages + EDS preview). There is no site setting here: each campaign folder
# names its own site in an html5.json file in the AEM folder, e.g. {"DA_ORG":"<org>","DA_SITE":"<site>"}
# (optional: DA_ADS_ROOT, default "" [site root]; EDS_REF, default main; GITHUB_REPO, default <org>/<site>).
# Pages are written as the signed-in user. Optional overrides, NOT for multi-user deployments (every user's
# writes would go as this token):
DA_TOKEN=
EDS_ADMIN_TOKEN=
# Package for CM360: repository_dispatch to the folder's site repo (needs access to that repo)
GITHUB_DISPATCH_TOKEN=
# 32+ random characters; signs the workflow's writeback token
HTML5_WRITEBACK_SECRET=
# Optional: defaults to this namespace's html5-writeback web action
HTML5_WRITEBACK_URL=
