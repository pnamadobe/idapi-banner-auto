# Copy to cloud/.env and fill in. cloud/.env is git-ignored by convention — never commit secrets.

# --- Adobe IMS auth: pick ONE path ---
#
# Path A — DURABLE, for an IMSS service-token client (recommended here).
#   From imss.corp.adobe.com -> your client (e.g. pnam-ffs-api, STAGE) ->
#   Service Tokens -> "Permanent Authorization Code" -> Show. Exchanged for a
#   fresh access token per run (grant_type=authorization_code). Nothing ephemeral.
FFS_AUTH_CODE=
FFS_CLIENT_ID=
FFS_CLIENT_SECRET=
#   For a service-token (auth-code) exchange the scope is the constant `system`
#   (verified working). The client's API scopes (indesign_services, etc.) are
#   carried from the IMSS client config, not requested here.
FFS_SCOPES=system
#   The IMSS client is STAGE, so use the stage IMS host (v1 supports auth-code exchange):
IMS_ENDPOINT=https://ims-na1-stg1.adobelogin.com/ims/token/v1
#
# Path B — ephemeral bearer token (quick one-off test only; expires ~8h).
#   IMSS -> Service Tokens -> "Generate short-lived service token". Overrides A/C.
FFS_ACCESS_TOKEN=
#
# Path C — OAuth Server-to-Server (client_credentials). Standard Firefly Services
#   path via Adobe Developer Console (requires the FFS license entitlement — blocked
#   for now). Would use FFS_CLIENT_ID/SECRET above with these scopes and prod IMS:
#   FFS_SCOPES=openid,AdobeID,creative_sdk,ff_apis,indesign_services
#   IMS_ENDPOINT=https://ims-na1.adobelogin.com/ims/token/v3

# --- optional overrides (defaults live in run.mjs) ---
# INDESIGN_API_BASE=https://indesign.adobe.io
# INDESIGN_SCRIPT_PATH=/v3/capabilities/script
# STORAGE_MODE=unset          # unset | adobe | s3 | azure  (see README → Storage)
# POLL_INTERVAL_MS=4000
# POLL_TIMEOUT_MS=600000
