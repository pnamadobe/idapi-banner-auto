# Copy to cloud/.env and fill in. cloud/.env is git-ignored by convention — never commit secrets.

# --- Adobe IMS auth: pick ONE path ---
#
# Path A — pre-generated bearer token (fastest for testing). From IMSS
#   (imss.corp.adobe.com) service-token client -> "Generate short-lived service token".
#   When set, this is used directly and client_credentials is skipped.
FFS_ACCESS_TOKEN=
#
# Path B — OAuth Server-to-Server (client_credentials). From Adobe Developer Console
#   -> project -> InDesign API -> OAuth Server-to-Server. (Requires FFS entitlement.)
FFS_CLIENT_ID=
FFS_CLIENT_SECRET=
# Scope string for the InDesign API OAuth S2S credential.
# Verified against the InDesign APIs / Firefly Services Dev Console onboarding page.
FFS_SCOPES=openid,AdobeID,creative_sdk,ff_apis,indesign_services

# --- optional overrides (defaults live in run.mjs) ---
# IMS_ENDPOINT=https://ims-na1.adobelogin.com/ims/token/v3
# INDESIGN_API_BASE=https://indesign.adobe.io
# INDESIGN_SCRIPT_PATH=/v3/capabilities/script
# STORAGE_MODE=unset          # unset | adobe | s3 | azure  (see README → Storage)
# POLL_INTERVAL_MS=4000
# POLL_TIMEOUT_MS=600000
