# Copy to cloud/.env and fill in. cloud/.env is git-ignored by convention — never commit secrets.

# --- Adobe IMS server-to-server credentials ---
# Adobe Developer Console -> your project -> InDesign API -> OAuth Server-to-Server
FFS_CLIENT_ID=
FFS_CLIENT_SECRET=
# Exact scope string from that credential (VERIFY — this default is a guess):
FFS_SCOPES=openid,AdobeID,read_organizations,firefly_api,ff_apis

# --- optional overrides (defaults live in run.mjs) ---
# IMS_ENDPOINT=https://ims-na1.adobelogin.com/ims/token/v3
# INDESIGN_API_BASE=https://indesign.adobe.io
# INDESIGN_SCRIPT_PATH=/v3/capabilities/script
# STORAGE_MODE=unset          # unset | adobe | s3 | azure  (see README → Storage)
# POLL_INTERVAL_MS=4000
# POLL_TIMEOUT_MS=600000
